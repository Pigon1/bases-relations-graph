{
	"name": "obsidian-bases-relations-graph",
	"version": "0.1.0",
	"description": "Visualize Bases as an interactive graph using cascading rule tables to show both direct links and relations defined through connector notes.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs --watch --deploy",
		"build": "tsc --noEmit && node esbuild.config.mjs --production",
		"deploy": "node esbuild.config.mjs --production --deploy",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/d3-force": "^3.0.10",
		"esbuild": "0.17.15",
		"obsidian": "1.14.4",
		"typescript": "~5.9.0"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"pixi.js": "~8.22.0"
	}
}
