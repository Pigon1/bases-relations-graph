views:
  - type: bases-relations-graph
    name: Relations
    order:
      - file.name
    layout: force
    linkDistance: 160
    showLegend: true
    nodes:
      - id: ndefault
        name: Default
        enabled: true
        condition:
        shape: circle
        color: rgba(140, 140, 140, 1)
        strokeColor:
        strokeWidth:
        sizeProperty: "@links"
        sizeValue: 1
        label:
          type: property
          property: file.basename
        labelIndex:
        labelSize: 13
        labelColor:
        labelBackground:
        show: show
      - id: navg7xn8
        name: Hide Graph
        enabled: true
        condition:
          and:
            - file.ext == "base"
        shape:
        color:
        strokeColor:
        strokeWidth:
        sizeProperty:
        sizeValue:
        label:
        labelIndex:
        labelSize:
        labelColor:
        labelBackground:
        show: hide
      - id: nrelations
        name: Relations are links
        enabled: true
        condition:
          and:
            - file.inFolder("Relations")
        shape:
        color:
        strokeColor:
        strokeWidth:
        sizeProperty:
        sizeValue:
        label:
        labelIndex:
        labelSize:
        labelColor:
        labelBackground:
        show: hide
      - id: npeople
        name: People
        enabled: true
        condition:
          and:
            - file.inFolder("People")
        shape: circle
        color: rgba(82, 172, 57, 1)
        strokeColor:
        strokeWidth:
        sizeProperty:
        sizeValue:
        label:
        labelIndex:
        labelSize:
        labelColor:
        labelBackground:
        show:
      - id: nplaces
        name: Places
        enabled: true
        condition:
          and:
            - file.inFolder("Places")
        shape: circle
        color: rgba(172, 72, 219, 1)
        strokeColor:
        strokeWidth:
        sizeProperty:
        sizeValue:
        label:
        labelIndex:
        labelSize:
        labelColor:
        labelBackground:
        show:
      - id: nevents
        name: Events
        enabled: true
        condition:
          and:
            - file.inFolder("Events")
        shape: diamond
        color: rgba(238, 192, 27, 1)
        strokeColor:
        strokeWidth:
        sizeProperty:
        sizeValue:
        label:
        labelIndex:
        labelSize:
        labelColor:
        labelBackground:
        show:
      - id: ncall
        name: Time to call
        enabled: true
        condition:
          and:
            - note.call_soon == true
        shape:
        color:
        strokeColor: rgba(229, 72, 77, 1)
        strokeWidth: 3
        sizeProperty:
        sizeValue:
        label:
          type: text
          text: call
        labelIndex: 1
        labelSize: 10
        labelColor: rgba(255, 255, 255, 1)
        labelBackground: rgba(229, 72, 77, 0.9)
        show:
    edges:
      - id: elinks
        name: Links
        enabled: true
        condition:
        source: "@note"
        sourceValue:
        target: "@links"
        targetValue:
        arrowToSource: false
        arrowToTarget: true
        color: rgba(160, 160, 160, 0.8)
        widthProperty: "@fixed"
        widthValue: 1
        label:
          type: none
        labelMode:
        labelPosition:
        labelSize:
        labelColor:
        labelBackground:
      - id: erelations
        name: Relations
        enabled: true
        condition:
        source: note.subjects
        sourceValue:
        target: note.objects
        targetValue:
        arrowToSource: false
        arrowToTarget: true
        color: rgba(240, 145, 81, 0.9)
        widthProperty: "@fixed"
        widthValue: 1.5
        label:
          type: property
          property: note.relations
        labelMode: tilted
        labelPosition: 50
        labelSize: 11
        labelColor: rgba(200, 110, 50, 1)
        labelBackground:
      - id: e1q61xu3
        name: Married
        enabled: true
        condition:
          and:
            - note.relations == "married"
        source: note.subjects
        sourceValue:
        target: note.objects
        targetValue:
        arrowToSource:
        arrowToTarget:
        color: rgba(209, 49, 211, 1)
        widthProperty:
        widthValue:
        label:
        labelMode:
        labelPosition:
        labelSize:
        labelColor: rgba(209, 49, 211, 1)
        labelBackground:
    groups:
      - id: gcircles
        name: Circles
        enabled: true
        groupBy: note.circle
        direction: ASC
        color:
        label:
        labelSize: 14
        labelColor: "@group"
        labelBackground:
  - type: bases-relations-graph
    name: Tree
