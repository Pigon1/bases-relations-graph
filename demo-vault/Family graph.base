        widthProperty: "@fixed"
        widthValue: 1.5
        label:
          type: property
          property: note.relations
        labelMode: tilted
        labelPosition: 50
        labelSize: 11
        labelColor: rgba(200, 110, 50, 1)
        labelBackground:
    groups:
      - id: gcircles
